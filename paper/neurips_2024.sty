% NeurIPS 2024 style file (preprint version)
% Based on the standard NeurIPS LaTeX style

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/01/01 NeurIPS 2024 submission/preprint style]

\newif\if@preprint
\@preprintfalse
\DeclareOption{preprint}{\@preprinttrue}
\DeclareOption{final}{\@preprintfalse}
\ProcessOptions\relax

% Page layout
\usepackage[verbose=true,letterpaper]{geometry}
\AtBeginDocument{
  \geometry{
    textheight=9in,
    textwidth=5.5in,
    top=1in,
    headheight=12pt,
    headsep=25pt,
    footskip=30pt
  }
}

% Fonts
\renewcommand{\rmdefault}{ptm}
\renewcommand{\sfdefault}{phv}

% Title formatting
\usepackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{1em}{}

% Abstract
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \vspace{0.5ex}%
  \begin{quote}%
}{%
  \end{quote}%
  \vskip 1ex%
}

% Paragraph spacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5ex}

% Header/footer
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\if@preprint
  \fancyhead[C]{\small Preprint. Under review.}
\fi
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0pt}

% Captions
\usepackage[font=small,labelfont=bf]{caption}
